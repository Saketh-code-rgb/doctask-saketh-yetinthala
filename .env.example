# Copy this file to .env and fill in real values.
# .env is gitignored and must never be committed.
#
# Secrets are read from the environment only. They must never appear in
# config/config.yaml, config/weights.yaml, or any other tracked file.
# See TECHNICAL_DESIGN.md section 19.

# GitHub personal access token.
# Required for GitHub code search, which is unavailable without one.
# Minimum scope only: public read access. No write scopes.
GITHUB_TOKEN=

# Libraries.io API key.
# Used for dependent_repositories lookups across ecosystems.
LIBRARIES_IO_API_KEY=
